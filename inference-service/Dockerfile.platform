# Reuse the CUDA/Python stack already validated on DGX; update application code only.
ARG INFERENCE_BASE=image-gen-inference:0.1.0-dev
FROM ${INFERENCE_BASE}
ARG SERVICE_VERSION=0.2.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.version=${SERVICE_VERSION} org.opencontainers.image.revision=${VCS_REF}
ENV PYTHONPATH=/app
COPY pyproject.toml /app/pyproject.toml
COPY inference_service /app/inference_service
COPY scripts /app/scripts
COPY tests /app/tests
CMD ["uvicorn", "inference_service.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
